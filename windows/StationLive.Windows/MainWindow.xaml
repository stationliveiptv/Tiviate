<Window x:Class="StationLive.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="STATION LIVE IPTV 4K" Height="650" Width="1000"
 Background="#080B12" WindowStartupLocation="CenterScreen">
 <Grid Margin="36">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="STATION LIVE" Foreground="#D6AD55" FontSize="30" FontWeight="Bold"/>
   <TextBlock Text="IPTV 4K  •  ENTERTAINMENT, YOUR WAY" Foreground="#9AA8BC" Margin="0,4,0,24"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#121927" CornerRadius="18" Padding="28" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
   <StackPanel>
    <TextBlock Text="Connect to your service" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,18"/>
    <TextBlock Text="Connection type" Foreground="#9AA8BC"/>
    <ComboBox x:Name="ConnectionType" SelectedIndex="0" Margin="0,6,0,14" Height="34">
     <ComboBoxItem Content="Xtream Codes"/>
     <ComboBoxItem Content="M3U / M3U8"/>
    </ComboBox>
    <TextBox x:Name="Username" Height="38" Padding="8" Margin="0,0,0,10" ToolTip="Username"/>
    <PasswordBox x:Name="Password" Height="38" Padding="8" Margin="0,0,0,10"/>
    <TextBox x:Name="PlaylistUrl" Height="38" Padding="8" Margin="0,0,0,14" Visibility="Collapsed" ToolTip="M3U playlist URL"/>
    <Button Content="CONTINUE" Height="44" Background="#D6AD55" Foreground="#080B12" FontWeight="Bold" Click="Continue_Click"/>
    <TextBlock x:Name="StatusText" Text="Connection service is not configured yet." Foreground="#9AA8BC" TextWrapping="Wrap" Margin="0,14,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
