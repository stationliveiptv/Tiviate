<Application x:Class="StationLive.Windows.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <Color x:Key="NightColor">#080B12</Color>
  <Color x:Key="GoldColor">#D6AD55</Color>
  <SolidColorBrush x:Key="NightBrush" Color="{StaticResource NightColor}"/>
  <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}"/>
 </Application.Resources>
</Application>
